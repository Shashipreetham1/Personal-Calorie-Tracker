# ---------------------------------------------------------------------------
# Personal Calorie Tracker — environment variables
#
# Copy to `.env` to override any default:   cp .env.example .env
#
# `docker compose up` works with NO .env file at all: docker-compose.yml carries
# a safe default for every variable below except GEMINI_API_KEY. Create a .env
# only to change a default or to supply the Gemini key (needed from Phase 7 on).
# Docker Compose auto-loads ./.env, so values set here reach both containers.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Credentials for the Postgres container. Changing these after the first
# `docker compose up` requires `docker compose down -v` (the volume keeps the
# credentials the database was initialised with).
POSTGRES_USER=calorie
POSTGRES_PASSWORD=calorie
POSTGRES_DB=calorie_tracker

# Full connection string used by the backend. Inside Docker the host is `db`
# (the compose service name); running the server on the host it is localhost.
DATABASE_URL=postgres://calorie:calorie@localhost:5432/calorie_tracker

# Maximum number of connections in the pg pool. Keep below Postgres'
# max_connections (100 by default) divided by the number of server instances.
PG_POOL_MAX=10

# --- Server ---------------------------------------------------------------
# development | test | production. Controls error verbosity and cookie flags.
NODE_ENV=development

# Port the Express server listens on.
PORT=4000

# Maximum accepted JSON request body size. Image and PDF uploads are
# multipart/form-data and are capped separately (see UPLOAD_MAX_BYTES).
JSON_BODY_LIMIT=1mb

# --- Auth -----------------------------------------------------------------
# Secret used to sign JWTs. MUST be replaced with a random value in production
# (e.g. `openssl rand -base64 48`). Minimum 32 characters.
JWT_SECRET=dev-only-insecure-secret-change-me-please-32

# JWT lifetime, as accepted by jsonwebtoken (e.g. 15m, 12h, 7d).
JWT_EXPIRES_IN=7d

# Name of the httpOnly cookie that carries the JWT.
COOKIE_NAME=ct_token

# --- CORS -----------------------------------------------------------------
# Comma-separated list of origins allowed to call the API with credentials.
# Must list the frontend origin exactly — `*` is invalid when credentials are
# enabled.
CORS_ORIGIN=http://localhost:5173

# --- AI (Gemini) — required from Phase 7 onwards --------------------------
# API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model used for image extraction, chat and PDF import.
GEMINI_MODEL=gemini-3.8-flash

# Upload ceiling for photo/PDF endpoints, in bytes (5 MB).
UPLOAD_MAX_BYTES=5242880

# --- Frontend -------------------------------------------------------------
# Base URL of the API, baked into the Vite build at build time. The frontend
# talks to the backend exclusively over this URL.
VITE_API_URL=http://localhost:4000/api
